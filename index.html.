<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#101b2b"><title>PATRULHAMENTO TÁTICO</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
<style>
*{box-sizing:border-box}body{margin:0;background:#101b2b;color:#f5f7fb;font:15px system-ui,Arial,sans-serif}header{padding:14px 18px;background:#17263a}h1{font-size:20px;margin:0}small{color:#b9c9db}.layout{display:grid;grid-template-columns:320px 1fr;min-height:calc(100dvh - 68px)}aside{padding:18px;background:#142236;overflow:auto}button,.upload{display:block;width:100%;padding:11px;margin:9px 0;border:0;border-radius:7px;background:#2d74b8;color:white;font:inherit;cursor:pointer;text-align:center}button.secondary,.upload{background:#344b66}button:disabled{opacity:.5;cursor:not-allowed}input[type=file]{width:100%;margin:8px 0}#map{height:calc(100dvh - 68px);min-height:400px;background:#d7e1e8}.info{padding:12px;background:#20344e;border-radius:8px;margin:14px 0;line-height:1.6;overflow-wrap:anywhere}.status{font-size:13px;color:#c8d8e8}a{color:#9cd1ff}@media(max-width:700px){.layout{display:flex;flex-direction:column}#map{height:58dvh;min-height:350px}aside{order:2}}
</style>
</head>
<body><header><h1>🛡️ PATRULHAMENTO TÁTICO</h1><small>Mapa e identificação de áreas de policiamento</small></header>
<div class="layout"><aside>
<button id="locate">📍 Localizar agora</button><button id="start">▶ Iniciar monitoramento</button><button id="stop" class="secondary" disabled>■ Parar monitoramento</button>
<div class="info"><strong>Importar áreas de policiamento</strong><p>Selecione um arquivo .kml ou .geojson contendo polígonos das áreas.</p><input id="file" type="file" accept=".kml,.geojson,.json,application/vnd.google-earth.kml+xml,application/geo+json"></div>
<div class="info"><strong>Área atual</strong><div id="area">Aguardando localização...</div><hr><strong>Delegacia responsável</strong><div id="station">Não informada</div><hr><strong>Hospital mais próximo</strong><div id="hospital">Consulte após obter localização.</div><button id="hospitalBtn" class="secondary" disabled>Buscar hospital próximo</button></div>
<button id="notify" class="secondary">🔔 Habilitar notificações</button><p id="status" class="status" role="status" aria-live="polite">Pronto. Importe o arquivo de áreas e permita a localização.</p><small>O monitoramento funciona enquanto a página estiver ativa. Dados de hospitais são consultados no OpenStreetMap e devem ser confirmados antes de uso operacional.</small>
</aside><main id="map" aria-label="Mapa interativo"></main></div>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script>
'use strict';
const $=id=>document.getElementById(id),status=msg=>{$('status').textContent=msg};
const map=L.map('map').setView([-23.5505,-46.6333],11);
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'&copy; OpenStreetMap contributors'}).addTo(map);
let areas=[],layer=null,marker=null,watchId=null,lastAreaId=null,currentPosition=null;
const escapeHTML=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const field=(props,names)=>{const keys=Object.keys(props||{});for(const name of names){const key=keys.find(k=>k.toLowerCase()===name.toLowerCase());if(key&&props[key]!=null&&String(props[key]).trim())return String(props[key])}return ''};
function notify(message){if('Notification' in window&&Notification.permission==='granted'&&document.visibilityState==='visible'){try{new Notification('PATRULHAMENTO TÁTICO',{body:message})}catch(e){status('Aviso de área: '+message)}}}
function ringContains(point,ring){let inside=false;for(let i=0,j=ring.length-1;i<ring.length;j=i++){const a=ring[i],b=ring[j];if((a[1]>point[1])!==(b[1]>point[1])&&point[0]<(b[0]-a[0])*(point[1]-a[1])/(b[1]-a[1])+a[0])inside=!inside}return inside}
function polygonContains(point,rings){return rings.length>0&&ringContains(point,rings[0])&&!rings.slice(1).some(r=>ringContains(point,r))}
function contains(geometry,lat,lng){if(!geometry)return false;const p=[lng,lat];if(geometry.type==='Polygon')return polygonContains(p,geometry.coordinates);if(geometry.type==='MultiPolygon')return geometry.coordinates.some(poly=>polygonContains(p,poly));return false}
function updateArea(lat,lng){const matches=areas.filter(f=>contains(f.geometry,lat,lng));const match=matches[0];const id=match?String(areas.indexOf(match)):'outside';const name=match?field(match.properties,['name','nome','area','área','setor','bairro'])||'Área sem nome':'Fora das áreas importadas';const station=match?field(match.properties,['delegacia','dp','distrito_policial','unidade','policia_civil'])||'Não informada no arquivo':'Não informada';$('area').textContent=name;$('station').textContent=station;if(lastAreaId!==null&&id!==lastAreaId&&match){notify('Entrada na área: '+name+'. Delegacia: '+station);status('Entrada detectada: '+name)}lastAreaId=id}
function onPosition(pos){const {latitude:lat,longitude:lng,accuracy}=pos.coords;currentPosition={lat,lng};if(!marker){marker=L.circleMarker([lat,lng],{radius:8,color:'#fff',weight:2,fillColor:'#1875db',fillOpacity:1}).addTo(map)}else marker.setLatLng([lat,lng]);map.setView([lat,lng],Math.max(map.getZoom(),15));$('hospitalBtn').disabled=false;updateArea(lat,lng);status('GPS atualizado. Precisão estimada: '+Math.round(accuracy)+' m.')}
function onGeoError(err){status('Falha no GPS: '+err.message+'. Verifique a permissão de localização e o HTTPS.');stopWatch()}
const geoOpts={enableHighAccuracy:true,maximumAge:5000,timeout:20000};
$('locate').onclick=()=>{if(!navigator.geolocation){status('Geolocalização indisponível neste navegador.');return}navigator.geolocation.getCurrentPosition(onPosition,onGeoError,geoOpts)};
function stopWatch(){if(watchId!==null){navigator.geolocation.clearWatch(watchId);watchId=null}$('start').disabled=false;$('stop').disabled=true}
$('start').onclick=()=>{if(!navigator.geolocation){status('GPS indisponível.');return}if(watchId!==null)return;watchId=navigator.geolocation.watchPosition(onPosition,onGeoError,geoOpts);$('start').disabled=true;$('stop').disabled=false;status('Monitoramento iniciado; mantenha a página aberta.')};
$('stop').onclick=()=>{stopWatch();status('Monitoramento interrompido.')};
$('notify').onclick=async()=>{if(!('Notification' in window)){status('Este navegador não suporta notificações desta página.');return}try{const p=await Notification.requestPermission();status(p==='granted'?'Notificações autorizadas.':'Notificações não autorizadas.')}catch(e){status('Não foi possível habilitar notificações: '+e.message)}};
function xmlChildren(node,name){return Array.from(node.children).filter(el=>el.localName===name)}
function xmlDesc(node,name){return Array.from(node.getElementsByTagName('*')).filter(el=>el.localName===name)}
function coords(text){return text.trim().split(/\s+/).map(t=>t.split(',').slice(0,2).map(Number)).filter(a=>a.length===2&&a.every(Number.isFinite))}
function kmlRing(polygon,tag){const boundary=xmlChildren(polygon,tag)[0];if(!boundary)return [];const el=xmlDesc(boundary,'coordinates')[0];return el?coords(el.textContent):[]}
function parseKML(source){const doc=new DOMParser().parseFromString(source,'application/xml');if(doc.querySelector('parsererror'))throw Error('KML inválido');const features=[];for(const pm of xmlDesc(doc,'Placemark')){const props={};const nm=xmlChildren(pm,'name')[0];if(nm)props.name=nm.textContent.trim();for(const data of xmlDesc(pm,'Data')){const key=data.getAttribute('name');const value=xmlChildren(data,'value')[0];if(key&&value)props[key]=value.textContent.trim()}for(const data of xmlDesc(pm,'SimpleData')){const key=data.getAttribute('name');if(key)props[key]=data.textContent.trim()}const polys=[];for(const poly of xmlDesc(pm,'Polygon')){const outer=kmlRing(poly,'outerBoundaryIs');if(outer.length<4)continue;const holes=xmlChildren(poly,'innerBoundaryIs').map(b=>{const el=xmlDesc(b,'coordinates')[0];return el?coords(el.textContent):[]}).filter(r=>r.length>=4);polys.push([outer,...holes])}if(polys.length)features.push({type:'Feature',properties:props,geometry:polys.length===1?{type:'Polygon',coordinates:polys[0]}:{type:'MultiPolygon',coordinates:polys}})}return {type:'FeatureCollection',features}}
$('file').onchange=async event=>{const file=event.target.files[0];if(!file)return;try{const txt=await file.text();const geo=/\.kml$/i.test(file.name)?parseKML(txt):JSON.parse(txt);const fs=geo.type==='FeatureCollection'?geo.features:geo.type==='Feature'?[geo]:geo.type==='Polygon'||geo.type==='MultiPolygon'?[{type:'Feature',properties:{name:file.name},geometry:geo}]:[];const valid=fs.filter(f=>f&&['Polygon','MultiPolygon'].includes(f.geometry?.type));if(!valid.length)throw Error('Nenhum polígono encontrado no arquivo');const newLayer=L.geoJSON({type:'FeatureCollection',features:valid},{style:{color:'#007dbb',weight:2,fillOpacity:.14},onEachFeature:(f,l)=>l.bindPopup(escapeHTML(field(f.properties,['name','nome','area','área'])||'Área sem nome'))}).addTo(map);if(layer)map.removeLayer(layer);layer=newLayer;areas=valid;lastAreaId=null;map.fitBounds(layer.getBounds(),{padding:[20,20]});if(currentPosition)updateArea(currentPosition.lat,currentPosition.lng);status(areas.length+' área(s) carregada(s) de '+file.name+'.')}catch(e){status('Erro ao importar: '+e.message)}};
$('hospitalBtn').onclick=async()=>{if(!currentPosition)return;const {lat,lng}=currentPosition;$('hospital').textContent='Consultando hospitais próximos...';const query=`[out:json][timeout:20];(nwr["amenity"="hospital"](around:10000,${lat},${lng}););out center;`;try{const response=await fetch('https://overpass.kumi.systems/api/interpreter',{method:'POST',body:new URLSearchParams({data:query})});if(!response.ok)throw Error('Serviço temporariamente indisponível');const data=await response.json();const rad=x=>x*Math.PI/180;const dist=(a,b)=>{const dlat=rad(b.lat-a.lat),dlng=rad(b.lng-a.lng);const h=Math.sin(dlat/2)**2+Math.cos(rad(a.lat))*Math.cos(rad(b.lat))*Math.sin(dlng/2)**2;return 6371*2*Math.atan2(Math.sqrt(h),Math.sqrt(1-h))};const hs=data.elements.map(x=>({name:x.tags?.name||'Hospital sem nome',lat:x.lat??x.center?.lat,lng:x.lon??x.center?.lon})).filter(x=>Number.isFinite(x.lat)&&Number.isFinite(x.lng)).map(x=>({...x,distance:dist({lat,lng},x)})).sort((a,b)=>a.distance-b.distance);if(!hs.length){$('hospital').textContent='Nenhum hospital cadastrado encontrado em 10 km.';return}const h=hs[0];$('hospital').textContent=`${h.name} — ${h.distance.toFixed(1)} km em linha reta.`;const url=`https://www.google.com/maps/search/?api=1&query=${h.lat},${h.lng}`;const link=document.createElement('a');link.href=url;link.target='_blank';link.rel='noopener noreferrer';link.textContent='Abrir localização no mapa';$('hospital').append(document.createElement('br'),link)}catch(e){$('hospital').textContent='Não foi possível consultar hospitais: '+e.message}};
</script></body></html>
